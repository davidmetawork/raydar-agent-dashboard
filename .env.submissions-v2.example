# Submissions V2 local configuration template.
# Keep every activation control false until a separately approved supervised launch.
SUBMISSIONS_V2_UI_ENABLED=false
SUBMISSIONS_V2_INGESTION_ENABLED=false
SUBMISSIONS_V2_GENERATION_ENABLED=false
SUBMISSIONS_V2_MASTER_INBOX_ENABLED=false
SUBMISSIONS_V2_CURATED_ENABLED=false

# Separate Postgres logins for the API and background worker.
SUBMISSIONS_V2_DATABASE_URL=
SUBMISSIONS_V2_WORKER_DATABASE_URL=
SUBMISSIONS_V2_TEST_DATABASE_URL=postgresql://localhost:5432/raydar_submissions_v2_test

# V2 human, machine, scheduler, and worker authentication.
SUBMISSIONS_V2_ADMIN_EMAILS=david@raydar.xyz
SUBMISSIONS_V2_ALLOWED_ORIGINS=https://monitor.raydar.xyz,http://localhost:3000,http://127.0.0.1:3000
SUBMISSIONS_V2_HUMAN_API_KEY=
SUBMISSIONS_V2_INGEST_KEY=
SUBMISSIONS_V2_SCHEDULER_KEY=
SUBMISSIONS_V2_WORKER_KEY=
SUBMISSIONS_V2_WORKER_ID=submissions-v2-local
SUBMISSIONS_V2_MASTER_INBOX_RECONCILE_URL=
SUBMISSIONS_V2_MASTER_INBOX_WORKER_KEY=

# Independent hard-purge service; provision the database login with the exact
# role name submissions_v2_purge, grant only the migration 005 functions, and
# leave this ceiling false until that isolated service is intentionally launched.
SUBMISSIONS_V2_PURGE_ENABLED=false
SUBMISSIONS_V2_PURGE_DATABASE_URL=
SUBMISSIONS_V2_PURGE_BLOB_READ_WRITE_TOKEN=
SUBMISSIONS_V2_PURGE_WORKER_ID=submissions-v2-purge-local
SUBMISSIONS_V2_PURGE_INTERVAL_MS=21600000

# Use independent random secrets; signing secrets require at least 32 characters,
# and SUBMISSIONS_V2_ENCRYPTION_KEY must decode to exactly 32 bytes.
SUBMISSIONS_V2_DOWNLOAD_SECRET=
SUBMISSIONS_V2_UPLOAD_SECRET=
SUBMISSIONS_V2_ENCRYPTION_KEY=
SUBMISSIONS_V2_RETENTION_HMAC_KEY=
SUBMISSIONS_V2_EMAIL_HMAC_KEY=
SUBMISSIONS_V2_EMAIL_HMAC_VERSION=v1

# The API owns the V2 Blob token and brokers exact one-minute GET/HEAD/PUT
# capabilities to the worker; the ordinary worker never receives a delete token.
SUBMISSIONS_V2_BLOB_READ_WRITE_TOKEN=
SUBMISSIONS_V2_BLOB_BROKER_URL=https://monitor.raydar.xyz/api/submissions-v2/internal/blob-capability
SUBMISSIONS_V2_BLOB_BROKER_KEY=

# Isolated authenticated PDF render/extract service.
SUBMISSIONS_V2_RENDERER_URL=http://127.0.0.1:8081
SUBMISSIONS_V2_RENDERER_KEY=

# Exact comma-separated HTTPS hosts approved for Paraform resume downloads.
SUBMISSIONS_V2_RESUME_DOWNLOAD_HOSTS=

# Mandatory authenticated malware scanner for recruiter PDF/image context.
# The scanner must return the digest-bound raydar.malware-scan.result.v1 receipt.
SUBMISSIONS_V2_MALWARE_SCANNER_URL=
SUBMISSIONS_V2_MALWARE_SCANNER_KEY=

# Slack destination and optional source-resume provenance denylist.
SUBMISSIONS_V2_SLACK_CHANNEL_ID=
SUBMISSIONS_V2_SLACK_BOT_TOKEN=
SUBMISSIONS_V2_KNOWN_RAYDAR_RESUME_DIGESTS=

# Provider credentials provisioned only to the isolated V2 worker.
SUBMISSIONS_V2_OPENAI_API_KEY=
SUBMISSIONS_V2_ANTHROPIC_API_KEY=

# Read-only Paraform service session provisioned only to the isolated V2 worker.
SUBMISSIONS_V2_PARAFORM_SESSION_COOKIE=
SUBMISSIONS_V2_PARAFORM_SESSION_COOKIE_NAME=

# Optional per-million-token price overrides used by the bounded cost forecast.
# Blank values retain the pinned defaults in pipeline-runtime.mjs.
SUBMISSIONS_V2_CLAUDE_OPUS_5_INPUT_PER_MILLION_USD=
SUBMISSIONS_V2_CLAUDE_OPUS_5_OUTPUT_PER_MILLION_USD=
SUBMISSIONS_V2_CLAUDE_OPUS_4_8_INPUT_PER_MILLION_USD=
SUBMISSIONS_V2_CLAUDE_OPUS_4_8_OUTPUT_PER_MILLION_USD=
SUBMISSIONS_V2_GPT_5_4_2026_03_05_INPUT_PER_MILLION_USD=
SUBMISSIONS_V2_GPT_5_4_2026_03_05_OUTPUT_PER_MILLION_USD=

# Existing Monitor session authentication used only by the V2 API shell.
AUTH_SESSION_SECRET=
GOOGLE_CLIENT_ID=
ALLOWED_DOMAINS=raydar.xyz,raydargroup.com,davidphillips.world

# Used by either the standalone worker or renderer process.
PORT=8080
