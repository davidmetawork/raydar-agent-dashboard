app = "raydar-submissions-v2-purge"
primary_region = "sjc"

[build]
  dockerfile = "submissions-v2-purge/Dockerfile"

[http_service]
  internal_port = 8080
  force_https = true
  auto_stop_machines = false
  auto_start_machines = true
  min_machines_running = 1

[[vm]]
  memory = "256mb"
  cpu_kind = "shared"
  cpus = 1
