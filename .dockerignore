# Keep remote build contexts limited to the files used by the Submissions V2
# worker, purge service, and renderer images.
**

!package.json
!package-lock.json

!fonts/
!fonts/**

!api/
!api/**

!resume-renderer/
!resume-renderer/**

!resume-renderer-v2/
!resume-renderer-v2/**

!submissions-v2-worker/
!submissions-v2-worker/**

!submissions-v2-purge/
!submissions-v2-purge/**

# Never upload local credentials, caches, or generated bytecode even if they
# appear under one of the explicitly included build directories.
**/.env
**/.env.*
**/*secret*
**/__pycache__/
**/__pycache__/**
**/*.py[cod]
